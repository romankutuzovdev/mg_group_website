# Backend API (FastAPI).
# Build/SSG: used as-is (http://… OK on the build machine).
NEXT_PUBLIC_API_URL=http://91.149.133.54
NEXT_PUBLIC_API_HTTPS_URL=https://api.mg-group.by
# Optional server-only override for Node build scripts:
# API_URL=http://91.149.133.54

# Browser on custom domain (mg-group.by) calls this origin for /api/v1/*
# because the zone may hijack /api → broken api.mg-group.by (530).
# NEXT_PUBLIC_PAGES_ORIGIN=https://multiglobalgroup-website.pages.dev

# Auction lot pages: default 0 = Cloudflare Function SSR (fast Next build).
# SEO_AUCTION_SSG_LIMIT=0

# Max auction URLs in sitemap.xml
# SEO_AUCTION_SITEMAP_LIMIT=5000

# Optional: Telegram Login Widget bot username (also set on API).
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotName
