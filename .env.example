# Backend API (FastAPI) on Windows Server.
# Browser on Vercel/HTTPS: leave NEXT_PUBLIC_API_URL unset (same-origin /api → vercel.json rewrite).
# Local / Windows static site:
# NEXT_PUBLIC_API_URL=http://91.149.133.54

# Vercel + local build (SSG catalog fetch) — server-only, not baked into browser JS:
API_URL=http://91.149.133.54

# Auction lot pages: 0 = skip Next SSG of every lot (faster Windows build).
SEO_AUCTION_SSG_LIMIT=0

# Max auction URLs in sitemap.xml
# SEO_AUCTION_SITEMAP_LIMIT=5000

# Optional: Telegram Login Widget bot username (also set on API).
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotName
