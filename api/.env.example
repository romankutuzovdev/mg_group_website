# MG.GROUP API local env (copy to api/.env)
#
# Deployment roles (see api/deploy/VPS-SPLIT.md):
#   APP_ROLE=all      — legacy: everything on one box (Windows today)
#   APP_ROLE=scraper  — Windows: Chrome + R2 photos + /internal/lots-catalog
#   APP_ROLE=public   — VPS: site + cabinet.db + pull lots from Windows
# Examples: api/deploy/vps/env.public.example | env.scraper.example
# APP_ROLE=all
# REDIRECT_APEX_TO_VERCEL=true
# LOTS_SOURCE_URL=http://91.149.133.54/api/v1/internal/lots-catalog
# LOTS_SOURCE_API_KEY=
# LOTS_SYNC_INTERVAL_SECONDS=120
# Windows → VPS push (scraper):
# PUBLIC_SITE_URL=http://178.172.138.96
# LOTS_PUSH_URL=http://178.172.138.96/api/v1/internal/lots-ingest
# LOTS_PUSH_API_KEY=
# LOTS_PUSH_INTERVAL_SECONDS=180
# CABINET_SOURCE_URL=http://91.149.133.54/api/v1/internal/cabinet-backup
# CABINET_SOURCE_API_KEY=

# Next.js static site folder (default: <repo>/out). Served by uvicorn on port 80.
# WEB_ROOT=C:\mg-api\out

# Playwright ingest / admin scripts
INGEST_API_KEY=

# Telegram Login Widget (required for cabinet)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
JWT_SECRET=change-me-to-a-long-random-string
CABINET_ADMIN_TELEGRAM_IDS=8257414851

# SMS.BY — токен: https://app.sms.by/user-api/token  альфа-имя: https://app.sms.by/alphanames
# На Windows-сервере (C:\mg-api\api\.env) раскомментируйте и заполните:
# SMS_BY_ENABLED=true
# SMS_BY_TOKEN=ваш_токен
# SMS_BY_ALPHANAME_ID=id_альфаимени

# Страница /admin/ — значения по умолчанию в коде: admin / MGGROUP
# CABINET_ADMIN_LOGIN=admin
# CABINET_ADMIN_PASSWORD=MGGROUP
# Клиенты, которые вошли через Telegram: таблица users в SQLite.
# По умолчанию api/data/cabinet.db (на сервере C:\mg-api\api\data\cabinet.db).
# CABINET_DB_PATH=

# Local-only test login (API only — no UI buttons on the website)
# CABINET_DEV_AUTH=false
# CABINET_DEV_TELEGRAM_ID=900001
# CABINET_DEV_CLIENT_TELEGRAM_ID=900002

# Scraper — YOUR Google Chrome (default profile), one tab per source
SCRAPER_AUTOSTART=true
SCRAPER_SOURCES=bidcars,copart_uk,manheim,salvage_market,encar,china_market
# Bid.cars: bounded cycles (search pages + capped detail opens)
SCRAPER_MAX_PAGES_BIDCARS=20
SCRAPER_BIDCARS_DETAIL_PER_CYCLE=40
SCRAPER_INTERVAL_SECONDS=600
# After Chrome is up: wait for VPN before Copart.com / Copart UK (seconds)
SCRAPER_STARTUP_DELAY_SECONDS=180
SCRAPER_VPN_SOURCES=copart,copart_uk
# Retry sooner when Incapsula blocks (after you flip VPN on)
SCRAPER_BLOCKED_RETRY_SECONDS=90
# Permanent calculator tab in the same Chrome
SCRAPER_CALC_TAB_ENABLED=true
SCRAPER_CALC_TAB_URL=http://127.0.0.1/calculator/
SCRAPER_PERSIST=true
SCRAPER_HEADLESS=false
SCRAPER_CDP_URL=http://127.0.0.1:9223
SCRAPER_CDP_AUTOSTART=true
SCRAPER_CDP_HEADLESS=false
SCRAPER_CDP_FALLBACK_LAUNCH=false
# Real Chrome profile (extensions + logins). Default if unset:
# SCRAPER_CHROME_USER_DATA=%LOCALAPPDATA%\Google\Chrome\User Data
# SCRAPER_CHROME_PROFILE_DIRECTORY=Default

# Photo enricher — open every lot card, collect all photos, nonstop daily
SCRAPER_PHOTOS_ENABLED=true
SCRAPER_PHOTO_BATCH_SIZE=25
SCRAPER_PHOTO_DELAY_SECONDS=2.5
SCRAPER_PHOTO_IDLE_SECONDS=300

# Cloudflare R2 — CDN for all auction region photos (scraper node uploads).
# Dashboard: R2 → Create bucket → Manage R2 API Tokens → Allow public access (r2.dev or custom domain).
# When auction ends, photos are deleted from R2 automatically (prune).
# R2_ENABLED=true
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=mg-group
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

