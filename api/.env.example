# MG.GROUP API local env (copy to api/.env)

# Next.js static site folder (default: <repo>/out). Served by uvicorn on port 80.
# WEB_ROOT=C:\mg-api\out

# Playwright ingest / admin scripts
INGEST_API_KEY=

# Telegram Login Widget (required for cabinet)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
JWT_SECRET=change-me-to-a-long-random-string
CABINET_ADMIN_TELEGRAM_IDS=

# Local-only test login (API only — no UI buttons on the website)
# CABINET_DEV_AUTH=false
# CABINET_DEV_TELEGRAM_ID=900001
# CABINET_DEV_CLIENT_TELEGRAM_ID=900002

# Scraper — ONE Google Chrome, separate tab per source
SCRAPER_AUTOSTART=true
SCRAPER_SOURCES=copart,iaai,copart_uk,manheim,salvage_market,encar
SCRAPER_INTERVAL_SECONDS=600
SCRAPER_PERSIST=true
SCRAPER_HEADLESS=false
# Windows: run api\scripts\start-chrome-cdp.bat first
# macOS:   run api/scripts/start-chrome-cdp.sh first
SCRAPER_CDP_URL=http://127.0.0.1:9223
# Auto-start Chrome if CDP port is down
SCRAPER_CDP_AUTOSTART=true
# HEADED (visible) Chrome - required for Copart/IAAI. Use Autologon + AnyDesk disconnect.
SCRAPER_CDP_HEADLESS=false
# Do not fall back to Playwright launch when CDP fails (avoids bot walls)
SCRAPER_CDP_FALLBACK_LAUNCH=false
# Optional: comma-separated unpacked extension folders (must contain manifest.json)
# Or drop them into api/data/chrome-extensions/<name>/
# SCRAPER_CHROME_LOAD_EXTENSION=C:\mg-api\api\data\chrome-extensions\my-addon
# Optional Manheim API token (else use logged-in Chrome session via CDP)
# SCRAPER_MANHEIM_BEARER_TOKEN=
# Encar needs KR egress (VPN / proxy Chrome profile)
# SCRAPER_MAX_PAGES_ENCAR=5
# Remove lots after auctionDate (+ grace hours)
SCRAPER_PRUNE_ENDED=true
SCRAPER_AUCTION_GRACE_HOURS=3

# Photo enricher — open every lot card, collect all photos, nonstop daily
SCRAPER_PHOTOS_ENABLED=true
SCRAPER_PHOTO_BATCH_SIZE=25
SCRAPER_PHOTO_DELAY_SECONDS=2.5
SCRAPER_PHOTO_IDLE_SECONDS=300
