# Windows scraper factory — Chrome + R2 + push catalog to VPS
APP_ROLE=scraper

# Public site lives on VPS — redirect mg-group.by here (not Vercel)
PUBLIC_SITE_URL=http://178.172.138.96
REDIRECT_APEX_TO_VERCEL=false

INGEST_API_KEY=change-me-long-random

# Push lots → VPS public API (same key on both sides)
LOTS_PUSH_URL=http://178.172.138.96/api/v1/internal/lots-ingest
LOTS_PUSH_API_KEY=change-me-long-random
LOTS_PUSH_INTERVAL_SECONDS=180

SCRAPER_AUTOSTART=true
SCRAPER_SOURCES=bidcars,copart_uk,salvage_market,manheim,encar,china_market
SCRAPER_PERSIST=true
SCRAPER_CDP_URL=http://127.0.0.1:9223
SCRAPER_PHOTOS_ENABLED=true

# Cloudflare R2 — all regions
R2_ENABLED=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mg-group
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# Cabinet DB stays on VPS — Windows can skip Telegram/SMS
