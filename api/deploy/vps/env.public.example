# VPS public node — site + cabinet + lot sync (no Chrome)
APP_ROLE=public
REDIRECT_APEX_TO_VERCEL=false

HOST=127.0.0.1
PORT=8080
WEB_ROOT=/opt/mg-group/out

# Same secret as Windows INGEST_API_KEY
INGEST_API_KEY=change-me-long-random

# Prefer: Windows PUSHes here (LOTS_PUSH_URL on scraper). Optional pull if VPS can reach Windows:
# LOTS_SOURCE_URL=http://91.149.133.54/api/v1/internal/lots-catalog
# LOTS_SOURCE_API_KEY=change-me-long-random
# LOTS_SYNC_INTERVAL_SECONDS=120

# One-shot: pull cabinet.db + uploads from Windows onto this hoster
CABINET_SOURCE_URL=http://91.149.133.54/api/v1/internal/cabinet-backup
CABINET_SOURCE_API_KEY=change-me-long-random

LOTS_JSON_PATH=/opt/mg-group/api/data/lots.json
CABINET_DB_PATH=/opt/mg-group/api/data/cabinet.db
CABINET_UPLOADS_DIR=/opt/mg-group/api/data/uploads

# No scraper on VPS
SCRAPER_AUTOSTART=false
SCRAPER_PHOTOS_ENABLED=false

JWT_SECRET=change-me-jwt
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
CABINET_ADMIN_TELEGRAM_IDS=8257414851

# SMS.BY (optional)
# SMS_BY_ENABLED=true
# SMS_BY_TOKEN=
# SMS_BY_ALPHANAME_ID=

# R2 not required on VPS (URLs already absolute CDN from Windows)
# R2_ENABLED=false
