{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://91.149.133.54/api/:path*"
    },
    {
      "source": "/auctions/:slug",
      "destination": "http://91.149.133.54/auctions/:slug/"
    },
    {
      "source": "/auctions/:slug/",
      "destination": "http://91.149.133.54/auctions/:slug/"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
